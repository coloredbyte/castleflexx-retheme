            "richtext_air": {
              "type": "lab-richtext",
              "settings": {
                "title": "Why to Test for PFAS?",
                "content": "<p>Independent PFAS testing helps verify that product materials have been screened for a broad range of regulated PFAS compounds. It also supports compliance with evolving global chemical regulations while giving customers greater confidence in the materials used.</p><p>For this test, SGS analyzed the CastleAir sample using advanced laboratory techniques, including GC-MS, GC-MS/MS, and HPLC-MS/MS, to screen for a comprehensive list of regulated PFAS compounds and PFAS-related substances. The results reported <strong>no detectable levels of the tested PFAS compounds above the applicable limits</strong>, resulting in a <strong>PASS</strong>.</p>",
                "disclaimer": "",
                "padding_bottom": 40,
