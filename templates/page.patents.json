    "faq": {
      "type": "faq",
      "blocks": {
        "faq_1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "Why does CastleFlexx have patents?",
            "row_content": "<p>CastleFlexx invests heavily in product innovation. Our patents help protect the unique design, engineering, and functionality of our stretching and mobility devices, ensuring customers receive an authentic, original product developed through years of research and testing.</p>"
          }
        },
        "faq_2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "What types of patents does CastleFlexx hold?",
            "row_content": "<p>CastleFlexx holds a combination of utility patents and design patents, along with additional patent applications in multiple countries. Utility patents protect how an invention works, while design patents protect its unique ornamental appearance.</p>"
          }
        },
        "faq_3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "What is the difference between an issued patent and a patent application?",
            "row_content": "<p>An issued patent has been reviewed and officially granted by the relevant patent office. A patent application is still under examination and has not yet been granted. Filing an application establishes a priority date while the patent office reviews the invention.</p>"
          }
        },
        "faq_4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "Why does CastleFlexx have patent applications in multiple countries?",
            "row_content": "<p>Patent rights are territorial, meaning they only apply in the countries where protection is sought. CastleFlexx has filed applications in several international markets to help protect its innovations as the brand continues to grow globally.</p>"
          }
        },
        "faq_5": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "Are all CastleFlexx products patented?",
            "row_content": "<p>Many of CastleFlexx's core technologies are protected by issued patents or pending patent applications. As the company develops new products and improvements, additional patent filings may be submitted to protect future innovations.</p>"
          }
        },
        "faq_6": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "Can I verify CastleFlexx's patents?",
            "row_content": "<p>Yes. Patent information is public record and can be searched through official patent office databases, including the U.S. Patent and Trademark Office (USPTO) and other international patent authorities.</p>"
          }
        },
        "faq_7": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "heading": "Does having a patent mean the product is clinically proven?",
            "row_content": "<p>No. Patents protect inventions and intellectual property; they do not certify clinical performance or medical effectiveness. Clinical studies, testing, and regulatory requirements are separate from the patent process.</p>"
          }
        }
      },
