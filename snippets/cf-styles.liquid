{% comment %}
-----------------------------------------------------------------------------
  Snippet: CF shared typography styles (cf-styles)
  - Defines the reusable .cf-title / .cf-subtitle classes.
  - Render this snippet from any section that uses them:
      {% render 'cf-styles' %}
-----------------------------------------------------------------------------
{% endcomment %}
<style>
  .cf-title {
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
  }

  .cf-subtitle {
    font-size: 1rem;
    color: #666768;
    text-align: center;
    margin-bottom: 40px;
  }

  /* Shared patent table (used by patent-record + patents-summary) */
  .patent-record__table-wrapper {
    overflow-x: auto;
  }

  .patent-record__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .patent-record__head {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-block: 18px;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(90deg, #85899A 0%, #51545C 100%);
    border-radius: 999px;
  }

  .patent-record__sr-head th {
    width: 33.33%;
    height: 0;
    padding: 0;
    font-size: 0;
    line-height: 0;
    overflow: hidden;
  }

  .patent-record__table td {
    padding: 16px;
    text-align: left;
    vertical-align: middle;
    color: #000000;
    font-size: 1rem;
    border-bottom: 0.75px solid #C6C6C6;
  }

  .patent-record__table td:nth-child(2),
  .patent-record__table td:last-child {
    text-align: center;
  }

  .patent-record__table td:last-child {
    overflow-wrap: anywhere;
  }

  .patent-record__patent-title {
    color: #000000;
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 2px;
  }

  .patent-record__patent-subtitle {
    color: #666768;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .cf-title {
      font-size: 1.875rem;
      margin-bottom: 12px;
    }

    .cf-subtitle {
      font-size: 0.875rem;
      margin-bottom: 28px;
    }

    .patent-record__head {
      font-size: 0.8125rem;
      padding-block: 16px;
    }

    .patent-record__table td,
    .patent-record__patent-title {
      font-size: 0.75rem;
    }

    .patent-record__table td:first-child {
      padding-left: 6px;
    }

    .patent-record__table td:last-child {
      padding-right: 6px;
    }

    .patent-record__patent-subtitle {
      font-size: 0.625rem;
    }
  }
</style>
