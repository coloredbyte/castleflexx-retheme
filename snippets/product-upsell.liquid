{%- comment -%}
  PDP upsell: one checkbox that adds a second item with the main product.

  Content comes from the product's metafields, so each product sets its own
  offer in admin (same data the old theme used):
  - custom.upsell_product: variant reference (e.g. CastleFit 12 months)
  - custom.upsell_title: rich text above the box
  - custom.upsell_description: text under the product name

  If the upsell product has a selling plan (CastleFit membership), the
  first plan is used and its discounted price is shown.

  The checkbox posts "properties[_upsell]" = "<variant id>|<selling plan id>"
  with the product form; product-cart.js turns it into a second cart line.
  Nothing renders when the metafield is empty or the variant can't be sold
  in this market.

  Accepts:
  - product: {Object} Main product (required)
  - block: {Object} Upsell block (required)
  - product_form_id: {String} Id of the product form (required)
  - section_id: {String} Main product section id, for the add to cart button (required)
{%- endcomment -%}
{%- liquid
  assign upsell_variant = product.metafields.custom.upsell_product.value
  assign upsell_ok = false
  if upsell_variant != blank and upsell_variant.available
    capture upsell_region_ok
      render 'variant-region-available', variant: upsell_variant
    endcapture
    unless upsell_region_ok contains 'false'
      assign upsell_ok = true
    endunless
  endif

  # Subscription price, e.g. CastleFit $149 -> $99 on the yearly plan.
  assign upsell_plan_id = ''
  assign upsell_price = upsell_variant.price
  assign upsell_allocation = upsell_variant.selling_plan_allocations.first
  if upsell_allocation != blank
    assign upsell_plan_id = upsell_allocation.selling_plan.id
    assign upsell_price = upsell_allocation.price
  endif

  assign upsell_input_id = 'x-upsell-' | append: product_form_id
  assign upsell_title = block.settings.heading
  if upsell_title == blank
    assign upsell_title = product.metafields.custom.upsell_title | metafield_tag
  endif
  assign upsell_description = block.settings.description
  if upsell_description == blank
    assign upsell_description = product.metafields.custom.upsell_description
  endif

  # Options layout (Heat / CastleAir): two radio cards instead of a checkbox.
  #   ( ) HEAT Only            $399
  #   ( ) HEAT + CastleFIT     $498   [Best value - Save $50]
  # "Save" is the upsell's plan discount, e.g. CastleFit $149 -> $99.
  assign layout = block.settings.layout | default: 'checkbox'
  if layout == 'options'
    # The metafield title is checkbox copy ("Add ... and get 34% off").
    assign upsell_title = block.settings.heading
  endif
  assign device_price = product.selected_or_first_available_variant.price
  assign upsell_savings = upsell_variant.price | minus: upsell_price | money_without_trailing_zeros
  assign upsell_badge = block.settings.badge | replace: '[savings]', upsell_savings
-%}
{%- if upsell_ok -%}
<div class="{% render 'scheme-class', scheme: block.settings.block_scheme, is_block: true %} x-product-upsell w-full mb-4 md:mb-6" {{ block.shopify_attributes }}>
  {%- if upsell_title != blank -%}
    <div class="x-product-upsell__title mb-2 font-medium">{{ upsell_title }}</div>
  {%- endif -%}

  {%- if layout == 'options' -%}
    {{ 'product-buy.css' | asset_url | stylesheet_tag }}
    <div class="x-buy-options{% if settings.edges_type == 'rounded_corners' %} x-buy--rounded{% endif %}" role="radiogroup">
      {%- comment -%} Empty value: product-cart.js drops it, so only the device is added. {%- endcomment -%}
      <label class="x-buy-option">
        <input
          type="radio"
          form="{{ product_form_id }}"
          name="properties[_upsell]"
          value=""
          class="x-buy-option__radio"
          {% unless block.settings.checked_by_default %}checked{% endunless %}
        >
        <span class="x-buy-option__text">
          <span class="x-buy-option__title">{{ block.settings.option_device_title | escape }}</span>
          {%- if block.settings.option_device_details != blank -%}
            <span class="x-buy-option__details">{{ block.settings.option_device_details | escape }}</span>
          {%- endif -%}
        </span>
        <span class="x-buy-option__price" data-upsell-price="device">{{ device_price | money_without_trailing_zeros }}</span>
      </label>

      <label class="x-buy-option">
        {%- if upsell_badge != blank -%}
          <span class="x-buy-badge">{{ upsell_badge | escape }}</span>
        {%- endif -%}
        <input
          id="{{ upsell_input_id }}"
          type="radio"
          form="{{ product_form_id }}"
          name="properties[_upsell]"
          value="{{ upsell_variant.id }}|{{ upsell_plan_id }}"
          class="x-buy-option__radio"
          {% if block.settings.checked_by_default %}checked{% endif %}
        >
        <span class="x-buy-option__text">
          <span class="x-buy-option__title">{{ block.settings.option_bundle_title | escape }}</span>
          {%- if block.settings.option_bundle_details != blank -%}
            <span class="x-buy-option__details">{{ block.settings.option_bundle_details | escape }}</span>
          {%- endif -%}
        </span>
        <span class="x-buy-option__price" data-upsell-price="bundle">{{ device_price | plus: upsell_price | money_without_trailing_zeros }}</span>
      </label>
    </div>
  {%- else -%}
  <label
    for="{{ upsell_input_id }}"
    class="flex items-start gap-3 cursor-pointer{% if block.settings.show_border %} p-4 border border-solid border-[rgba(var(--colors-line-and-border))]{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}{% endif %}"
  >
    <input
      id="{{ upsell_input_id }}"
      type="checkbox"
      form="{{ product_form_id }}"
      name="properties[_upsell]"
      value="{{ upsell_variant.id }}|{{ upsell_plan_id }}"
      class="checkbox checkbox-checked shrink-0 mt-0.5 w-5 h-5 min-w-[20px] md:h-6 md:w-6 md:min-w-[24px] border-2 checked:border-[rgba(var(--colors-text-link))] checked:bg-[rgba(var(--colors-text-link))] relative cursor-pointer{% if settings.edges_type == 'rounded_corners' %} rounded{% else %} rounded-none{% endif %}"
      {% if block.settings.checked_by_default %}checked{% endif %}
    >

    {%- if block.settings.show_image and upsell_variant.product.featured_image != blank -%}
      <img
        src="{{ upsell_variant.product.featured_image | image_url: width: 120 }}"
        alt="{{ upsell_variant.product.featured_image.alt | escape }}"
        width="60"
        height="60"
        loading="lazy"
        class="shrink-0 w-[60px] h-[60px] object-cover{% if settings.edges_type == 'rounded_corners' %} rounded{% endif %}"
      >
    {%- endif -%}

    <span class="flex flex-col gap-1">
      {%- if upsell_badge != blank -%}
        <span class="x-product-upsell__badge self-start">{{ upsell_badge | escape }}</span>
      {%- endif -%}
      <a href="{{ upsell_variant.product.url }}" class="underline" @click.stop>{{ upsell_variant.product.title }}</a>
      {%- if upsell_description != blank -%}
        <span class="text-sm opacity-80">{{ upsell_description }}</span>
      {%- endif -%}
      <span class="flex gap-2 text-sm">
        {%- if upsell_price < upsell_variant.price -%}
          <s class="opacity-60">{{ upsell_variant.price | money }}</s>
        {%- endif -%}
        <span class="font-medium">{{ upsell_price | money }}</span>
      </span>
    </span>
  </label>

  {%- comment -%}
    Policy row under the box, as on the live theme:
    "30 Day Return Policy | USA Owned"; ticking the upsell swaps in the
    bundle text, e.g. "60 Day Return Policy".
  {%- endcomment -%}
  {%- if block.settings.return_text != blank or block.settings.origin_text != blank -%}
    <div class="x-product-upsell__policy flex flex-wrap gap-2 mt-2 text-sm">
      {%- if block.settings.return_text != blank -%}
        <span
          class="x-product-upsell__return"
          data-upsell-return
          data-text="{{ block.settings.return_text | escape }}"
          data-text-bundle="{{ block.settings.return_text_bundle | default: block.settings.return_text | escape }}"
        >
          {{- block.settings.return_text | escape -}}
        </span>
      {%- endif -%}
      {%- if block.settings.origin_text != blank -%}
        <span class="x-product-upsell__origin">{{ block.settings.origin_text | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- endif -%}

  <script>
    // Add the upsell to the add to cart total while chosen, e.g. $239 -> $338.
    // Variant changes re-render the button from the server, so re-apply then.
    // Runs after load: the button sits below this block in the page.
    //
    // Options layout also shows each option's total, and announces the
    // choice with "cf:upsell:change" so buy sections lower on the page
    // (product-buy-box, product-buy-cards) stay in sync.
    document.addEventListener('DOMContentLoaded', () => {
      const UPSELL_PRICE = {{ upsell_price }};
      const block = document.getElementById('{{ upsell_input_id }}')?.closest('.x-product-upsell');
      const button = document.getElementById('x-atc-button-{{ section_id }}');
      if (!block || !button) {
        return;
      }

      const inputs = block.querySelectorAll('input[name="properties[_upsell]"]');
      const isBundle = () => [...inputs].some((input) => input.checked && input.value !== '');

      const moneyFormat = () => {
        {%- if settings.currency_code_enable %}
          return window.Eurus.money_with_currency_format;
        {%- else %}
          return window.Eurus.money_format;
        {%- endif %}
      };

      // "$399.00" -> "$399", matching money_without_trailing_zeros.
      const format = (cents) => Alpine.store('xHelper').formatMoney(cents, moneyFormat());
      const formatShort = (cents) => format(cents).replace(/[.,]00(?=\D*$)/, '');

      const setText = (el, text) => {
        // Writing the text triggers the observer again; equal text ends it.
        if (el && el.textContent.trim() !== text) {
          el.textContent = text;
        }
      };

      const sync = () => {
        const base = button.querySelector('.target-price');
        if (!base || !window.Alpine) {
          return;
        }

        const devicePrice = Number(base.textContent);
        const bundle = isBundle();
        setText(button.querySelector('[id^="atc-price-"]'), format(devicePrice + (bundle ? UPSELL_PRICE : 0)));
        setText(block.querySelector('[data-upsell-price="device"]'), formatShort(devicePrice));
        setText(block.querySelector('[data-upsell-price="bundle"]'), formatShort(devicePrice + UPSELL_PRICE));

        const returnText = block.querySelector('[data-upsell-return]');
        if (returnText) {
          setText(returnText, bundle ? returnText.dataset.textBundle : returnText.dataset.text);
        }

        document.dispatchEvent(new CustomEvent('cf:upsell:change', {
          detail: { bundle, devicePrice, upsellPrice: UPSELL_PRICE }
        }));
      };

      inputs.forEach((input) => input.addEventListener('change', sync));
      new MutationObserver(sync).observe(button, { childList: true, subtree: true });
      document.addEventListener('alpine:initialized', sync);
      sync();
    });
  </script>
</div>
{%- endif -%}
