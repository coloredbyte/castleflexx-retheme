<div x-show="show" class="x-container-sidebar-popup fixed z-[70] left-0 top-0 right-0 bottom-0 flex justify-end" x-cloak>
  <div x-show="show" x-cloak class="x-overlay absolute top-0 left-0 right-0 bottom-0 bg-[#acacac] bg-opacity-30"></div>
  <div class="x-container-sidebar-popup-content w-full md:w-[450px] flex flex-col relative bg-[rgba(var(--background-color))]{% if settings.edges_type == 'rounded_corners' %} md:mt-2.5 md:mb-2.5 md:mr-2.5 md:ml-2.5 md:rounded-[10px]{% endif %}"
    id="HeaderSidebar-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    x-show="show" x-cloak
    x-intersect.full="$store.xModal.focus('HeaderSidebar-{{ section.id }}', 'CloseHeaderSidebar-{{ section.id }}');"
    x-transition:enter="transition-all ease-in-out duration-500"
    x-transition:enter-start="opacity-0 transform translate-y-1/3{% if settings.lang_direction contains request.locale.iso_code %} md:-translate-x-1/3{% else %} md:translate-x-1/3{% endif %} md:translate-y-0"
    x-transition:enter-end="opacity-100 transform translate-y-0 md:translate-x-0 md:translate-y-0"
    x-transition:leave="transition-all ease-in-out duration-500"
    x-transition:leave-end="opacity-0 transform translate-y-1/3{% if settings.lang_direction contains request.locale.iso_code %} md:-translate-x-1/3{% else %} md:translate-x-1/3{% endif %} md:translate-y-0"
    @click.away="show = false"
    @keydown.escape="show = false; $store.xModal.removeFocus();"
  >
    <div class="x-container-sidebar-popup-header pl-5 pr-5 pt-5 pb-5 flex items-center justify-between">
      <h3 class="text-[150%] leading-tight p-break-words w-[calc(100%-40px)]">{{ section.settings.sidebar_heading | escape }}</h3>
      <button id="CloseHeaderSidebar-{{ section.id }}" aria-label="{{ 'accessibility.close' | t }}" class="icon-close-container rounded-full absolute top-2 right-2 rtl:right-auto rtl:left-2 group-close-btn cursor-pointer" @click.prevent="show = false; $store.xModal.removeFocus();">
        {% render 'icon-alls', icon: 'icon-close', animation_class: 'icon-close-animation' %}
      </button>
    </div>
    <div class="x-container-sidebar-popup-content pl-5 pr-5 flex flex-col overflow-y-auto scrollbar-body" role="list">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'sidebar_content' %}
            {% liquid 
              assign content_layout = ''
              if block.settings.content_layout == 'overlay-with-opacity'
                assign content_layout = 'overlay'
              endif
              assign panel_bg = false
              assign panel_bg_dark = false
              if content_layout != 'overlay'
                if block.settings.block_scheme != 'section'
                  assign panel_bg = true
                  assign panel_bg_dark = true
                else
                  if block.settings.content_background_color != blank and block.settings.content_background_color.alpha != 0
                    assign panel_bg = true
                  endif
                  if block.settings.content_background_color_dark != blank and block.settings.content_background_color_dark.alpha != 0
                    assign panel_bg_dark = true
                  endif
                endif
              endif
            %}
            {% style %}  
              .button--{{ block.id }}.button-solid { 
                {% if block.settings.color_button != blank and block.settings.color_button.alpha != 0 -%}
                  --colors-line-and-border: {{ block.settings.color_button.red }}, {{ block.settings.color_button.green }}, {{ block.settings.color_button.blue }};
                  --colors-button: {{ block.settings.color_button.red }}, {{ block.settings.color_button.green }}, {{ block.settings.color_button.blue }};
                {%- else -%}
                  --colors-line-and-border: var(--colors-button);
                {%- endif %}
                {% if block.settings.color_button_hover != blank and block.settings.color_button_hover.alpha != 0 -%}
                  --colors-button-hover: {{ block.settings.color_button_hover.red }}, {{ block.settings.color_button_hover.green }}, {{ block.settings.color_button_hover.blue }};
                {%- endif %}
                {% if block.settings.color_text_button != blank and block.settings.color_text_button.alpha != 0 -%}
                  --colors-button-text: {{ block.settings.color_text_button.red }}, {{ block.settings.color_text_button.green }}, {{ block.settings.color_text_button.blue }};
                {%- endif %}
                {% if block.settings.color_text_button_hover != blank and block.settings.color_text_button_hover.alpha != 0 -%}
                  --colors-button-text-hover: {{ block.settings.color_text_button_hover.red }}, {{ block.settings.color_text_button_hover.green }}, {{ block.settings.color_text_button_hover.blue }};
                {%- endif %}
              }
              .button--{{ block.id }}.button.button-outline {
                {% if block.settings.secondary_button_text != blank and block.settings.secondary_button_text.alpha != 0 -%}
                  --colors-secondary-button: {{ block.settings.secondary_button_text.red }}, {{ block.settings.secondary_button_text.green }}, {{ block.settings.secondary_button_text.blue }};
                  --colors-line-secondary-button: {{ block.settings.secondary_button_text.red }}, {{ block.settings.secondary_button_text.green }}, {{ block.settings.secondary_button_text.blue }};
                  --background-secondary-button: transparent;
                {%- endif %}
                {% if block.settings.color_button_secondary != blank and block.settings.color_button_secondary.alpha != 0 -%}
                  --background-secondary-button: {{ block.settings.color_button_secondary.red }}, {{ block.settings.color_button_secondary.green }}, {{ block.settings.color_button_secondary.blue }};
                  --colors-line-secondary-button: {{ block.settings.color_button_secondary.red }}, {{ block.settings.color_button_secondary.green }}, {{ block.settings.color_button_secondary.blue }};
                {%- endif %}
              }
              .button--{{ block.id }}.button.button-text-link {
                {% if block.settings.colors_text_link != blank and block.settings.colors_text_link.alpha != 0 -%}
                  --colors-text-link: {{ block.settings.colors_text_link.red }}, {{ block.settings.colors_text_link.green }}, {{ block.settings.colors_text_link.blue }};
                {%- endif %}
              }
              .content-bg-{{ block.id }} {
                {% if block.settings.content_background_color != blank and block.settings.content_background_color.alpha != 0 -%}
                  background-color: {{ block.settings.content_background_color }};
                  --image-treatment-overlay: {{ block.settings.content_background_color.red }}, {{ block.settings.content_background_color.green }}, {{ block.settings.content_background_color.blue }};
                {%- elsif block.settings.block_scheme != 'section' and content_layout != 'overlay' -%}
                  background-color: rgb(var(--colors-background));
                {%- endif %}
              }
              .text-content-{{ block.id }} {
                {% if block.settings.color_heading != blank and block.settings.color_heading.alpha != 0 -%}
                  --colors-heading: {{ block.settings.color_heading.red }}, {{ block.settings.color_heading.green }}, {{ block.settings.color_heading.blue }};
                {%- endif %}
                {% if block.settings.color_text != blank and block.settings.color_text.alpha != 0 -%}
                  --colors-text: {{ block.settings.color_text.red }}, {{ block.settings.color_text.green }}, {{ block.settings.color_text.blue }};
                {%- endif %}
              }
              {%- if settings.edges_type == 'rounded_corners' -%}
                .media-radius-{{ block.id }} {
                  border-radius: {% if panel_bg %}0{% else %}10px{% endif %};
                }
              {%- endif -%}
              {%- if settings.theme_mode_enabled -%}
                {%- if settings.edges_type == 'rounded_corners' and panel_bg_dark != panel_bg -%}
                  .dark .media-radius-{{ block.id }} {
                    border-radius: {% if panel_bg_dark %}0{% else %}10px{% endif %};
                  }
                {%- endif -%}
                .dark .button--{{ block.id }}.button.button-solid {
                  {%- if block.settings.color_button_dark != blank and block.settings.color_button_dark.alpha != 0 -%}
                    --colors-line-and-border: {{ block.settings.color_button_dark.red }}, {{ block.settings.color_button_dark.green }}, {{ block.settings.color_button_dark.blue }};
                    --colors-button: {{ block.settings.color_button_dark.red }}, {{ block.settings.color_button_dark.green }}, {{ block.settings.color_button_dark.blue }};
                  {%- elsif block.settings.color_button != blank and block.settings.color_button.alpha != 0 -%}
                    --colors-line-and-border: var(--colors-button);
                    --colors-button: inherit;
                  {%- endif -%}
                  {%- if block.settings.color_button_hover_dark != blank and block.settings.color_button_hover_dark.alpha != 0 -%}
                    --colors-button-hover: {{ block.settings.color_button_hover_dark.red }}, {{ block.settings.color_button_hover_dark.green }}, {{ block.settings.color_button_hover_dark.blue }};
                  {%- elsif block.settings.color_button_hover != blank and block.settings.color_button_hover.alpha != 0 -%}
                    --colors-button-hover: inherit;
                  {%- endif -%}
                  {%- if block.settings.color_text_button_dark != blank and block.settings.color_text_button_dark.alpha != 0 -%}
                    --colors-button-text: {{ block.settings.color_text_button_dark.red }}, {{ block.settings.color_text_button_dark.green }}, {{ block.settings.color_text_button_dark.blue }};
                  {%- elsif block.settings.color_text_button != blank and block.settings.color_text_button.alpha != 0 -%}
                    --colors-button-text: inherit;
                  {%- endif -%}
                  {%- if block.settings.color_text_button_hover_dark != blank and block.settings.color_text_button_hover_dark.alpha != 0 -%}
                    --colors-button-text-hover: {{ block.settings.color_text_button_hover_dark.red }}, {{ block.settings.color_text_button_hover_dark.green }}, {{ block.settings.color_text_button_hover_dark.blue }};
                  {%- elsif block.settings.color_text_button_hover != blank and block.settings.color_text_button_hover.alpha != 0 -%}
                    --colors-button-text-hover: inherit;
                  {%- endif -%}
                }
                .dark .button--{{ block.id }}.button.button-outline {
                  {%- liquid
                    assign secondary_text_dark_set = false
                    if block.settings.secondary_button_text_dark != blank and block.settings.secondary_button_text_dark.alpha != 0
                      assign secondary_text_dark_set = true
                    endif
                  -%}
                  {%- if secondary_text_dark_set -%}
                    --colors-secondary-button: {{ block.settings.secondary_button_text_dark.red }}, {{ block.settings.secondary_button_text_dark.green }}, {{ block.settings.secondary_button_text_dark.blue }};
                    --colors-line-secondary-button: {{ block.settings.secondary_button_text_dark.red }}, {{ block.settings.secondary_button_text_dark.green }}, {{ block.settings.secondary_button_text_dark.blue }};
                    --background-secondary-button: transparent;
                  {%- elsif block.settings.secondary_button_text != blank and block.settings.secondary_button_text.alpha != 0 -%}
                    --colors-secondary-button: inherit;
                    --colors-line-secondary-button: inherit;
                    --background-secondary-button: inherit;
                  {%- endif -%}
                  {%- if block.settings.color_button_secondary_dark != blank and block.settings.color_button_secondary_dark.alpha != 0 -%}
                    --background-secondary-button: {{ block.settings.color_button_secondary_dark.red }}, {{ block.settings.color_button_secondary_dark.green }}, {{ block.settings.color_button_secondary_dark.blue }};
                    --colors-line-secondary-button: {{ block.settings.color_button_secondary_dark.red }}, {{ block.settings.color_button_secondary_dark.green }}, {{ block.settings.color_button_secondary_dark.blue }};
                  {%- elsif secondary_text_dark_set == false and block.settings.color_button_secondary != blank and block.settings.color_button_secondary.alpha != 0 -%}
                    --background-secondary-button: inherit;
                    --colors-line-secondary-button: inherit;
                  {%- endif -%}
                }
                .dark .button--{{ block.id }}.button.button-text-link, .dark .button--{{ block.id }}.button.button-text-link::after {
                  {%- if block.settings.colors_text_link_dark != blank and block.settings.colors_text_link_dark.alpha != 0 -%}
                    --colors-text-link: {{ block.settings.colors_text_link_dark.red }}, {{ block.settings.colors_text_link_dark.green }}, {{ block.settings.colors_text_link_dark.blue }};
                  {%- elsif block.settings.colors_text_link != blank and block.settings.colors_text_link.alpha != 0 -%}
                    --colors-text-link: inherit;
                  {%- endif -%}
                }
                .dark .content-bg-{{ block.id }} {
                  {%- if block.settings.content_background_color_dark != blank and block.settings.content_background_color_dark.alpha != 0 -%}
                    background-color: {{ block.settings.content_background_color_dark }};
                    --image-treatment-overlay: {{ block.settings.content_background_color_dark.red }}, {{ block.settings.content_background_color_dark.green }}, {{ block.settings.content_background_color_dark.blue }};
                  {%- elsif block.settings.content_background_color != blank and block.settings.content_background_color.alpha != 0 -%}
                    {%- if content_layout == 'overlay' -%}
                      background-color: rgb(var(--image-treatment-overlay));
                    {%- elsif block.settings.block_scheme == 'section' -%}
                      background-color: transparent;
                    {%- else -%}
                      background-color: rgb(var(--colors-background));
                    {%- endif -%}
                    --image-treatment-overlay: inherit;
                  {%- endif -%}
                }
                .dark .text-content-{{ block.id }} {
                  {%- if block.settings.color_heading_dark != blank and block.settings.color_heading_dark.alpha != 0 -%}
                    --colors-heading: {{ block.settings.color_heading_dark.red }}, {{ block.settings.color_heading_dark.green }}, {{ block.settings.color_heading_dark.blue }};
                  {%- elsif block.settings.color_heading != blank and block.settings.color_heading.alpha != 0 -%}
                    --colors-heading: inherit;
                  {%- endif -%}
                  {%- if block.settings.color_text_dark != blank and block.settings.color_text_dark.alpha != 0 -%}
                    --colors-text: {{ block.settings.color_text_dark.red }}, {{ block.settings.color_text_dark.green }}, {{ block.settings.color_text_dark.blue }};
                  {%- elsif block.settings.color_text != blank and block.settings.color_text.alpha != 0 -%}
                    --colors-text: inherit;
                  {%- endif -%}
                }
              {%- endif -%}
            {% endstyle %}
            {% liquid
              assign container_class = ''
              if block.settings.content_layout == 'top-image'
                assign container_class = 'flex flex-col-reverse'
              elsif block.settings.content_layout == 'bottom-image'
                assign container_class = 'flex flex-col'
              elsif block.settings.content_layout == 'left-image'
                assign container_class = 'flex flex-row-reverse'
              elsif block.settings.content_layout == 'right-image'
                assign container_class = 'flex flex-row'
              else
                assign container_class = 'relative'
              endif
            %}
            <div class="{% render 'scheme-class', scheme: block.settings.block_scheme, is_block: true %}{% unless block.settings.block_scheme == 'section' or block.settings.block_scheme == blank %} scheme-header-roles{% endunless %} x-seasonal-deal-container pb-5">     
              <div class="overflow-hidden {{ container_class }}{% unless content_layout == 'overlay' %} content-bg-{{ block.id }}{% endunless %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">     
                {% if block.settings.image != blank %}
                  {% liquid
                    assign ratio = 100 
                    if block.settings.image_ratio == 'portrait'
                      assign ratio = 150 
                    endif
                    if block.settings.image_ratio == 'landscape'
                      assign ratio = 75 
                    endif
                    if block.settings.image_ratio == 'wide'
                      assign ratio = 56 
                    endif
                    if block.settings.image_ratio == '3/4'
                      assign ratio = 133 
                    endif
                  %}
                  <div class="relative flex-1 x-seasonal-deal-image{% unless block.settings.image_ratio == "natural" %} pb-[{{ ratio }}%]{% endunless %}"
                    style="{% if block.settings.image_ratio == "natural" %}padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%{% endif %}"
                  >
                    <picture>
                      {% # theme-check-disable ImgLazyLoading %}
                      <img class="w-full h-full absolute top-0 object-cover animate-Xpulse skeleton-image media-radius-{{ block.id }}"
                        srcset="{{ block.settings.image | image_url: width: 375 }} 375w,
                          {{ block.settings.image | image_url: width: 450 }} 450w,
                          {{ block.settings.image | image_url: width: 750 }} 750w,"
                        src="{{ block.settings.image | image_url: width: 750 }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                        onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image') });"
                        sizes="(min-width: 768px) 700px, 100vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        style="object-position: {{ block.settings.image.presentation.focal_point }};"
                      >
                      {% # theme-check-enable ImgLazyLoading %}
                    </picture>
                  </div>
                  {% if block.settings.content_layout == 'overlay-with-opacity' %}
                    <div class="{% if settings.edges_type == 'rounded_corners' %}rounded-[10px]{% endif %} content-bg-{{ block.id }} absolute top-0 left-0 bottom-0 right-0 z-10 image-treatment-overlay pointer-events-none opacity-{{ block.settings.overlay_opacity }}"></div>
                  {% endif %}
                {% else %}
                  {% liquid
                    assign placeholder_class = 'absolute w-full h-full bg-[#c9c9c9] text-[#acacac]'
                    assign placeholder_class = placeholder_class | append: ' media-radius-' | append: block.id
                  %}
                  <div class="relative flex-1 x-placeholder-image pb-[100%]">
                    {{ 'image' | placeholder_svg_tag: placeholder_class }}
                  </div>
                {% endif %}
                {% if block.settings.promotion_heading != blank or block.settings.promotion_subheading != blank or block.settings.promotion_des != blank %}
                  {% liquid
                    assign overlay_container_class = ''
                    if content_layout == 'overlay'
                      if block.settings.content_position == 'top-left'
                        assign overlay_container_class = 'justify-start items-start'
                      elsif block.settings.content_position == 'top-center'
                        assign overlay_container_class = 'justify-center items-start'
                      elsif block.settings.content_position == 'top-right'
                        assign overlay_container_class = 'justify-end items-start'
                      elsif block.settings.content_position == 'middle-left'
                        assign overlay_container_class = 'justify-start items-center'
                      elsif block.settings.content_position == 'middle-center'
                        assign overlay_container_class = 'justify-center items-center'
                      elsif block.settings.content_position == 'middle-right'
                        assign overlay_container_class = 'justify-end items-center'
                      elsif block.settings.content_position == 'bottom-left'
                        assign overlay_container_class = 'justify-start items-end'
                      elsif block.settings.content_position == 'bottom-center'
                        assign overlay_container_class = 'justify-center items-end'
                      elsif block.settings.content_position == 'bottom-right'
                        assign overlay_container_class = 'justify-end items-end'
                      endif
                    endif
                  %}
                  {% if content_layout == 'overlay' %}
                    <div class="top-0 left-0 right-0 bottom-0 absolute flex z-20 {{ overlay_container_class }}">
                  {% endif %}
                    <div class="x-seasonal-deal-text-content text-content-{{ block.id }} flex-1{% if content_layout == 'overlay' %} absolute w-[80%]{% endif %}">
                      <div class="pr-4 pl-4 pb-4 pt-4 flex flex-col gap-5 text-{% if block.settings.content_alignment == 'left' %}start{% elsif block.settings.content_alignment == 'right' %}end{% else %}center{% endif %} {% if block.settings.content_alignment == 'left' %}items-start{% elsif block.settings.content_alignment == 'right' %}items-end{% else %}items-center{% endif %}">
                        <p class="text-[rgb(var(--colors-text))]">{{ block.settings.promotion_subheading }}</p>
                        <h3>{{ block.settings.promotion_heading }}</h3>
                        <div class="rte text-[rgb(var(--colors-text))]">{{ block.settings.promotion_des}}</div>
                        {% if block.settings.button_link == blank %}
                          <div class="w-fit button--{{ block.id }} button{% if block.settings.show_button_style == 'secondary' %} button-outline{% elsif block.settings.show_button_style == 'text-link' %} button-text-link{% else %} button-solid{% endif %} leading-normal empty:hidden text-center pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3 opacity-70 disable-btn-animation hover:cursor-not-allowed">
                            {% render 'button-label', button_label: block.settings.button_label, show_button_style: block.settings.show_button_style %}
                          </div>
                        {% else %}
                          <a class="w-fit button--{{ block.id }} button{% if block.settings.show_button_style == 'secondary' %} button-outline{% elsif block.settings.show_button_style == 'text-link' %} button-text-link{% else %} button-solid{% endif %} leading-normal empty:hidden text-center pl-7 pr-7 pt-2.5 pb-2.5 md:pl-8 md:pr-8 md:pt-3 md:pb-3" href="{{ block.settings.button_link }}"{% if block.settings.open_new_window_button %} target="_blank"{% endif %}>
                            {% render 'button-label', button_label: block.settings.button_label, show_button_style: block.settings.show_button_style %}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% if content_layout == 'overlay' %}
                    </div>
                  {% endif %}
                {% endif %}
              </div> 
            </div> 
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>