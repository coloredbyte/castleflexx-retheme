<div class="castlefit-pagination">
  {%- if paginate.pages > 1 -%}
    <nav role="navigation">
      <ol class="castlefit-pagination--list">
        {%- if paginate.previous-%}
          <li>
            <a href="{{ paginate.previous.url }}">
              <span aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.25 14.25L6 9L11.25 3.75" stroke="#3E4044" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
            </a>
          </li>
        {%- else -%}
          <li class="disabled">
            <span aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11.25 14.25L6 9L11.25 3.75" stroke="#3E4044" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
          </li>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <li>
              <a href="{{ part.url }}">
                <span class="visually-hidden">page</span> {{ part.title }}
              </a>
            </li>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <li class="active" aria-current="page">
                <span class="visually-hidden">page</span> {{ part.title }}
              </li>
            {%- else -%}
              <li>
                <span class="visually-hidden">page</span> {{ part.title }}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if paginate.next -%}
          <li>
            <a href="{{ paginate.next.url }}">
              <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
              <span aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.75 3.75L12 9L6.75 14.25" stroke="#3E4044" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </li>
        {%- else -%}
          <li class="disabled">
            <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
            <span aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.75 3.75L12 9L6.75 14.25" stroke="#3E4044" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </li>
        {%- endif -%}
      </ol>
    </nav>
  {%- endif -%}
</div>