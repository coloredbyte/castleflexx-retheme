{%- comment -%}
  Bottom-of-page buy box (Heat "Buy Section").

            GET YOUR HEAT
       Choose Your Heat Experience
    01 Choose your size          +----------------------+
       [Standard][Large][XL]     |        image         |
    02 Choose your buying option | HEAT + CASTLEFIT     |
       ( ) HEAT Only      $399   | $548 $498            |
       (o) HEAT + FIT     $498   | ✓ includes ...       |
                                 | [   Shop Bundle    ] |
                                 +----------------------+

  Controls mirror the main product form through product-buy-sync.js, so
  size and option stay in sync with the top of the page and the CTA
  adds exactly what the main form would. Needs the main product section
  on the same page and an Upsell block set to "Two options".
{%- endcomment -%}
{%- liquid
  assign section_class = 'x-buy-box-' | append: section.id
  assign current = product.selected_or_first_available_variant

  # Size picker: the product option named in settings, e.g. Size.
  assign size_option = blank
  assign size_index = 0
  for option in product.options_with_values
    if option.name == section.settings.size_option
      assign size_option = option
      assign size_index = forloop.index0
    endif
  endfor

  # Upsell (CastleFit) prices: full price is the bundle's strikethrough.
  assign upsell_variant = product.metafields.custom.upsell_product.value
  assign upsell_full = 0
  assign upsell_price = 0
  if upsell_variant != blank
    assign upsell_full = upsell_variant.price
    assign upsell_price = upsell_variant.price
    assign upsell_allocation = upsell_variant.selling_plan_allocations.first
    if upsell_allocation != blank
      assign upsell_price = upsell_allocation.price
    endif
  endif

  assign size_notes = section.settings.size_notes | newline_to_br | split: '<br />'
  assign device_items = section.settings.device_items | newline_to_br | split: '<br />'
  assign bundle_items = section.settings.bundle_items | newline_to_br | split: '<br />'

-%}

{{ 'product-buy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-buy-sync.js' | asset_url }}" defer></script>

{%- style -%}
  .{{ section_class }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="{% render 'scheme-class', scheme: section.settings.section_scheme %} {{ section_class }}{% if settings.edges_type == 'rounded_corners' %} x-buy--rounded{% endif %}">
  <div class="page-width">
    <div class="x-buy-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="x-buy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="x-buy-subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="x-buy-box__grid">
      <div class="x-buy-box__steps">
        {%- if size_option != blank -%}
          <fieldset class="x-buy-box__step">
            <legend class="x-buy-box__legend h4">
              <span class="x-buy-box__number">01</span>
              {{- section.settings.size_label | escape -}}
            </legend>

            <div class="x-buy-box__sizes">
              {%- for value in size_option.values -%}
                {%- liquid
                  # Note per size, "Standard: 5'0 - 5'8" -> "5'0 - 5'8".
                  assign note = ''
                  assign prefix = value | append: ':'
                  for line in size_notes
                    # Starts with, not contains: "Large:" is inside "X-Large:".
                    assign clean = line | strip
                    assign head = clean | slice: 0, prefix.size
                    if head == prefix
                      assign note = clean | remove_first: prefix | strip
                    endif
                  endfor
                -%}
                <label class="x-buy-box__size">
                  <input
                    type="radio"
                    name="buy-box-size-{{ section.id }}"
                    value="{{ value | escape }}"
                    data-buy-box-size
                    {% if current.options[size_index] == value %}checked{% endif %}
                  >
                  <span class="x-buy-box__size-name">{{ value | escape }}</span>
                  {%- if note != blank -%}
                    <span class="x-buy-box__size-note">{{ note | escape }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>

            {%- if section.settings.size_help != blank -%}
              <div class="x-buy-box__help rte">{{ section.settings.size_help }}</div>
            {%- endif -%}
          </fieldset>
        {%- endif -%}

        {%- if upsell_variant != blank -%}
          <fieldset class="x-buy-box__step">
            <legend class="x-buy-box__legend h4">
              <span class="x-buy-box__number">
                {%- if size_option != blank -%}02{%- else -%}01{%- endif -%}
              </span>
              {{- section.settings.option_label | escape -}}
            </legend>

            <div class="x-buy-options">
              <label class="x-buy-option">
                <input type="radio" class="x-buy-option__radio" name="buy-box-option-{{ section.id }}" value="device" data-buy-box-option checked>
                <span class="x-buy-option__text">
                  <span class="x-buy-option__title">{{ section.settings.device_title | escape }}</span>
                  <span class="x-buy-option__details">{{ section.settings.device_details | escape }}</span>
                </span>
                <span class="x-buy-option__price" data-buy-box-price="device">{{ current.price | money_without_trailing_zeros }}</span>
              </label>

              <label class="x-buy-option">
                {%- if section.settings.badge != blank -%}
                  {%- assign savings = upsell_full | minus: upsell_price | money_without_trailing_zeros -%}
                  <span class="x-buy-badge">{{ section.settings.badge | replace: '[savings]', savings | escape }}</span>
                {%- endif -%}
                <input type="radio" class="x-buy-option__radio" name="buy-box-option-{{ section.id }}" value="bundle" data-buy-box-option>
                <span class="x-buy-option__text">
                  <span class="x-buy-option__title">{{ section.settings.bundle_title | escape }}</span>
                  <span class="x-buy-option__details">{{ section.settings.bundle_details | escape }}</span>
                </span>
                <span class="x-buy-option__price" data-buy-box-price="bundle">{{ current.price | plus: upsell_price | money_without_trailing_zeros }}</span>
              </label>
            </div>
          </fieldset>
        {%- endif -%}
      </div>

      <div class="x-buy-card">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 40vw, 100vw', class: 'x-buy-card__image'
          }}
        {%- endif -%}

        <div class="x-buy-card__body">
          {%- comment -%} One summary per option; JS shows the chosen one. {%- endcomment -%}
          {%- for choice in (1..2) -%}
            {%- liquid
              if forloop.first
                assign key = 'device'
                assign title = section.settings.device_title
                assign price = current.price
                assign compare = blank
                assign items = device_items
                assign cta = section.settings.device_cta
                assign note = ''
              else
                assign key = 'bundle'
                assign title = section.settings.bundle_title
                assign price = current.price | plus: upsell_price
                assign compare = current.price | plus: upsell_full
                assign items = bundle_items
                assign cta = section.settings.bundle_cta
                assign note = section.settings.bundle_note
              endif
            -%}
            <div data-buy-box-summary="{{ key }}"{% if key == 'bundle' %} hidden{% endif %}>
              <p class="x-buy-card__eyebrow">{{ title | escape }}</p>

              <p class="x-buy-card__price">
                {%- if compare != blank and compare > price -%}
                  <s class="x-buy-card__compare" data-buy-box-compare>{{ compare | money_without_trailing_zeros }}</s>
                {%- endif -%}
                <span class="x-buy-card__amount" data-buy-box-total>{{ price | money_without_trailing_zeros }}</span>
              </p>

              {%- if section.settings.includes_label != blank -%}
                <p class="x-buy-card__intro">{{ section.settings.includes_label | escape }}</p>
              {%- endif -%}

              <ul class="x-buy-card__items">
                {%- for line in items -%}
                  {%- assign item = line | strip -%}
                  {%- if item == blank -%}
                    {%- continue -%}
                  {%- endif -%}

                  <li class="x-buy-card__item">
                    <span class="x-buy-card__check" aria-hidden="true">✓</span>
                    {{ item | escape }}
                  </li>
                {%- endfor -%}
              </ul>

              <button type="button" class="button button-solid x-buy-card__cta" data-buy-box-submit>
                {{- cta | escape -}}
              </button>

              {%- if note != blank -%}
                <p class="x-buy-card__note">{{ note | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('.{{ section_class }}');
    const sync = window.cfBuySync;
    if (!root || !sync) {
      return;
    }

    const SIZE_POSITION = {{ size_option.position | default: 0 }};
    const UPSELL_FULL = {{ upsell_full }};
    const moneyFormat = window.Eurus.{% if settings.currency_code_enable %}money_with_currency_format{% else %}money_format{% endif %};
    const formatShort = (cents) => Alpine.store('xHelper').formatMoney(cents, moneyFormat).replace(/[.,]00(?=\D*$)/, '');

    const setText = (el, text) => {
      if (el && el.textContent.trim() !== text) {
        el.textContent = text;
      }
    };

    // Buy box -> main form.
    root.querySelectorAll('[data-buy-box-size]').forEach((radio) => {
      radio.addEventListener('change', () => sync.selectOption(radio.value));
    });
    root.querySelectorAll('[data-buy-box-option]').forEach((radio) => {
      radio.addEventListener('change', () => sync.chooseBundle(radio.value === 'bundle'));
    });
    root.querySelectorAll('[data-buy-box-submit]').forEach((button) => {
      button.addEventListener('click', () => sync.submit());
    });

    // Main form -> buy box: size.
    document.addEventListener('eurus:variant:change', (event) => {
      const value = event.detail?.variant?.options?.[SIZE_POSITION - 1];
      const radio = [...root.querySelectorAll('[data-buy-box-size]')].find((input) => input.value === value);
      if (radio) {
        radio.checked = true;
      }
    });

    // Main form -> buy box: option and prices.
    document.addEventListener('cf:upsell:change', (event) => {
      const { bundle, devicePrice, upsellPrice } = event.detail;
      const key = bundle ? 'bundle' : 'device';

      root.querySelector(`[data-buy-box-option][value="${key}"]`).checked = true;
      root.querySelectorAll('[data-buy-box-summary]').forEach((summary) => {
        summary.hidden = summary.dataset.buyBoxSummary !== key;
      });

      setText(root.querySelector('[data-buy-box-price="device"]'), formatShort(devicePrice));
      setText(root.querySelector('[data-buy-box-price="bundle"]'), formatShort(devicePrice + upsellPrice));

      const shown = root.querySelector(`[data-buy-box-summary="${key}"]`);
      setText(shown.querySelector('[data-buy-box-total]'), formatShort(devicePrice + (bundle ? upsellPrice : 0)));
      setText(shown.querySelector('[data-buy-box-compare]'), formatShort(devicePrice + UPSELL_FULL));
    });

    // Sold out or region-blocked: buttons follow the main button.
    sync.followButton(root.querySelectorAll('[data-buy-box-submit]'));
  });
</script>

{% schema %}
{
  "name": "Product buy box",
  "tag": "section",
  "class": "section-product-buy-box",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Mirrors the main product form: size and option stay in sync with the top of the page. Needs an Upsell block set to \"Two options\" in Product information."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get your Heat"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Heat Experience"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Buy the device alone or add the program designed to keep you using it."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "text",
      "id": "size_option",
      "label": "Size option name",
      "default": "Size",
      "info": "Products without this option skip the size step."
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Size step label",
      "default": "Choose your size"
    },
    {
      "type": "textarea",
      "id": "size_notes",
      "label": "Size notes",
      "default": "Standard: 5'0 – 5'8\nLarge: 5'9 – 6'2\nX-Large: 6'3 – 6'9",
      "info": "One per line, \"Size: note\"."
    },
    {
      "type": "richtext",
      "id": "size_help",
      "label": "Size help",
      "default": "<p>Between Sizes? <strong>Size Up</strong></p>"
    },
    {
      "type": "header",
      "content": "Buying option"
    },
    {
      "type": "text",
      "id": "option_label",
      "label": "Option step label",
      "default": "Choose your buying option"
    },
    {
      "type": "text",
      "id": "device_title",
      "label": "Device option title",
      "default": "CastleFlexx HEAT Only"
    },
    {
      "type": "text",
      "id": "device_details",
      "label": "Device option details",
      "default": "Built-in Heat • USB-C Rechargeable • 30-Day Returns"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Upsell option title",
      "default": "CastleFlexx HEAT + CastleFIT"
    },
    {
      "type": "text",
      "id": "bundle_details",
      "label": "Upsell option details",
      "default": "Heat Device • 200+ guided classes"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Upsell option badge",
      "default": "Best value • Save [savings]",
      "info": "[savings] shows the upsell discount, e.g. $50."
    },
    {
      "type": "header",
      "content": "Summary card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "includes_label",
      "label": "Includes label",
      "default": "Your purchase includes:"
    },
    {
      "type": "textarea",
      "id": "device_items",
      "label": "Device option includes",
      "default": "CastleFlexx Heat device\n30-day worry-free returns",
      "info": "One per line."
    },
    {
      "type": "textarea",
      "id": "bundle_items",
      "label": "Upsell option includes",
      "default": "CastleFlexx Heat device\n200+ guided classes\n60-day worry-free returns\n12 months of device insurance",
      "info": "One per line."
    },
    {
      "type": "text",
      "id": "device_cta",
      "label": "Device button label",
      "default": "Shop Heat"
    },
    {
      "type": "text",
      "id": "bundle_cta",
      "label": "Upsell button label",
      "default": "Shop Bundle"
    },
    {
      "type": "text",
      "id": "bundle_note",
      "label": "Upsell note",
      "default": "CastleFIT renews annually until cancelled."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_scheme",
      "label": "t:sections.all.color_scheme.label",
      "info": "t:sections.all.color_scheme.info",
      "default": "store",
      "options": [
        { "value": "store", "label": "t:sections.all.color_scheme.store" },
        { "value": "scheme2", "label": "t:sections.all.color_scheme.soft" },
        { "value": "scheme3", "label": "t:sections.all.color_scheme.bold" },
        { "value": "scheme4", "label": "t:sections.all.color_scheme.accent" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product buy box"
    }
  ]
}
{% endschema %}
