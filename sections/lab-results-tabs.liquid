{% comment %}
-----------------------------------------------------------------------------
  Section: Lab Results Tabs (lab-results-tabs)
  - Tab bar built from the titles of the child `lab-tab` theme blocks, plus the
    tab panels themselves rendered via `content_for 'blocks'`.
  - Structure/behaviour only for now — styling is intentionally minimal.
-----------------------------------------------------------------------------
{% endcomment %}

{%- comment -%} Stable anchor so other buttons can link here, e.g. /pages/lab-results#lab-results {%- endcomment -%}
<div
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handle }}"{% endif %}
  class="lab-tabs"
  style="
    --lab-tabs-pt: {{ section.settings.desktop_padding_top }}px;
    --lab-tabs-pb: {{ section.settings.desktop_padding_bottom }}px;
    --lab-tabs-pt-m: {{ section.settings.mobile_padding_top }}px;
    --lab-tabs-pb-m: {{ section.settings.mobile_padding_bottom }}px;
  ">
  <div class="lab-tabs__inner">
    <div class="lab-tabs__nav" role="tablist"></div>

    <div class="lab-tabs__panels">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lab-tabs {
    padding-top: var(--lab-tabs-pt);
    padding-bottom: var(--lab-tabs-pb);
  }

  #shopify-section-{{ section.id }} .lab-tabs__inner {
    max-width: 1300px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  #shopify-section-{{ section.id }} .lab-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    margin-bottom: 44px;
  }

  #shopify-section-{{ section.id }} .lab-tabs__nav:empty {
    display: none;
  }

  #shopify-section-{{ section.id }} .lab-tabs__tab {
    cursor: pointer;
    padding: 8px 0;
    border: 0;
    border-bottom: 1px solid transparent;
    /* Eurus rounds all buttons, which curves the underline */
    border-radius: 0;
    background: transparent;
    font-size: 1.375rem;
    font-weight: 600;
    color: #8c8c8c;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .lab-tabs__tab[aria-selected='true'] {
    font-size: 1.75rem;
    color: #000;
    border-bottom-color: #000;
  }

  #shopify-section-{{ section.id }} .lab-tab {
    display: none;
  }

  #shopify-section-{{ section.id }} .lab-tab.is-active {
    display: block;
  }

  /* Card row: the lab-card blocks at the top of a tab sit in one horizontal
     strip, wrapped by JS so merchants can still reorder them freely. */
  #shopify-section-{{ section.id }} .lab-tabs__cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 48px;
  }

  #shopify-section-{{ section.id }} .lab-card {
    height: 100%;
    background: #f7f8f6;
    border-radius: 16px;
    /* Minimum breathing room even when the block's padding is 0 */
    padding: max(var(--pt, 0px), 24px) 24px max(var(--pb, 0px), 24px);
  }

  /* Title left, badge-or-logo right — always the same slot, 4px gap. */
  #shopify-section-{{ section.id }} .lab-card__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .lab-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #191a1b;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lab-card__badge {
    flex: none;
    background: #7892a4;
    color: #fff;
    border-radius: 100px;
    padding: 5px 14px;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .lab-card__media {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .lab-card__image {
    height: 20px;
    width: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .lab-card__subtitle {
    font-size: 0.875rem;
    color: #191a1b;
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .lab-card__description {
    font-size: 0.9375rem;
    color: #666768;
  }

  #shopify-section-{{ section.id }} .lab-card__description p {
    margin: 0;
  }

  /* Tab content */
  #shopify-section-{{ section.id }} .lab-tab-content {
    padding-top: var(--pt, 0);
    padding-bottom: var(--pb, 0);
  }

  #shopify-section-{{ section.id }} .lab-tab-content__title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    color: #191a1b;
    margin: 0 0 40px;
  }

  /* When a subtitle follows, it owns the gap to the content instead. */
  #shopify-section-{{ section.id }} .lab-tab-content__title:has(+ .lab-tab-content__subtitle) {
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__subtitle {
    font-size: 1.125rem;
    color: #6b6c6d;
    text-align: center;
    margin: 0 0 40px;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__blocks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 64px;
    row-gap: 32px;
  }

  /* With a main image: two property columns flanking a centered image.
     4 properties → 2 left / 2 right, image spans both rows in the middle. */
  /* Two equal rows so a left/right pair always shares the same baseline,
     regardless of the (tall) image or differing text lengths. */
  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media {
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 48px;
    row-gap: 1px;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__media {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    justify-self: center;
    width: 320px;
    max-width: 100%;
  }

  /* The media is always the first child, so the four properties are children
     2-5. Place them explicitly: left column (right-aligned to hug the image),
     then right column (left-aligned). nth-of-type would mis-target because the
     media div shares the same tag, so use nth-child on the known order. */
  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(2) {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(3) {
    grid-column: 1;
    grid-row: 2;
    justify-self: end;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(4) {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(5) {
    grid-column: 3;
    grid-row: 2;
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property__body {
    max-width: 288px;
  }

  #shopify-section-{{ section.id }} .lab-tab-content__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .lab-result-property {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .lab-result-property__icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
  }

  #shopify-section-{{ section.id }} .lab-result-property__icon-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .lab-result-property__title {
    font-size: 1rem;
    font-weight: 600;
    color: #191a1b;
    margin: 0 0 6px;
  }

  #shopify-section-{{ section.id }} .lab-result-property__description {
    font-size: 0.875rem;
    color: #6b6c6d;
  }

  #shopify-section-{{ section.id }} .lab-result-property__description p {
    margin: 0;
  }

  /* Lab details panel. The pt/pb settings are OUTER spacing (margin) so they
     don't disturb the 32px box inset. */
  #shopify-section-{{ section.id }} .lab-details {
    border: 1px solid #c4c4c4;
    border-radius: 16px;
    padding: 32px;
    margin-top: var(--pt, 0);
    margin-bottom: var(--pb, 0);
  }

  #shopify-section-{{ section.id }} .lab-details__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .lab-details__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #191a1b;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lab-details__logo-image {
    height: var(--lab-logo-h, 33px);
    width: auto;
    display: block;
  }

  /* Result value takes the pass/fail colour from the block's `pass` checkbox. */
  #shopify-section-{{ section.id }} .lab-details {
    --lab-result-color: #449a74;
  }

  #shopify-section-{{ section.id }} .lab-details[data-pass='false'] {
    --lab-result-color: #a74449;
  }

  #shopify-section-{{ section.id }} .lab-property--result .lab-property__value {
    color: var(--lab-result-color);
    font-weight: 600;
  }

  /* 5 rows per side: fill the first column top-to-bottom, then the second. */
  #shopify-section-{{ section.id }} .lab-details__properties {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(5, auto);
    grid-auto-flow: column;
    column-gap: 60px;
    row-gap: 10px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .lab-property {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    font-size: 1.125rem;
  }

  #shopify-section-{{ section.id }} .lab-property__label {
    font-weight: 600;
    color: #191a1b;
  }

  #shopify-section-{{ section.id }} .lab-property__value {
    color: #3e4044;
  }

  #shopify-section-{{ section.id }} .lab-property__value p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lab-details__summary-label {
    font-size: 1.125rem;
    font-weight: 600;
    color: #191a1b;
    margin-bottom: 4px;
  }

  #shopify-section-{{ section.id }} .lab-details__summary {
    font-size: 1.125rem;
    color: #3e4044;
  }

  #shopify-section-{{ section.id }} .lab-details__summary p {
    margin: 0;
  }

  /* Summary takes the remaining width; the button keeps its intrinsic size. */
  #shopify-section-{{ section.id }} .lab-details__footer {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .lab-details__summary-wrap {
    flex: 1 1 auto;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .lab-details__report-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    font-size: 0.875rem;
  }

  #shopify-section-{{ section.id }} .lab-details__note {
    font-size: 0.875rem;
    color: #3e4044;
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .lab-details__note p {
    margin: 0;
  }

  /* Richtext */
  #shopify-section-{{ section.id }} .lab-richtext {
    padding-top: var(--pt, 0);
    padding-bottom: var(--pb, 0);
  }

  #shopify-section-{{ section.id }} .lab-richtext__title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #191a1b;
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .lab-richtext__content {
    font-size: 1.125rem;
    color: #3e4044;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .lab-richtext__content p {
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .lab-richtext__disclaimer {
    font-size: 0.875rem;
    color: #3e4044;
    line-height: 1.5;
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .lab-richtext__disclaimer p {
    margin: 0;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .lab-tabs__cards {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Odd card out (e.g. 5th of 5) spans the row instead of leaving a gap */
    #shopify-section-{{ section.id }} .lab-tabs__cards > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .lab-card {
      padding: max(var(--pt-m, 0px), 16px) 16px max(var(--pb-m, 0px), 16px);
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .lab-tab-content,
    #shopify-section-{{ section.id }} .lab-richtext {
      padding-top: var(--pt-m, 0);
      padding-bottom: var(--pb-m, 0);
    }

    #shopify-section-{{ section.id }} .lab-details {
      margin-top: var(--pt-m, 0);
      margin-bottom: var(--pb-m, 0);
    }

    #shopify-section-{{ section.id }} .lab-card__title {
      font-size: 1rem;
    }

    #shopify-section-{{ section.id }} .lab-card__badge {
      font-size: 0.75rem;
    }

    #shopify-section-{{ section.id }} .lab-card__subtitle {
      font-size: 0.75rem;
    }

    #shopify-section-{{ section.id }} .lab-card__description {
      font-size: 0.75rem;
    }

    #shopify-section-{{ section.id }} .lab-card__image {
      height: 13px;
    }

    #shopify-section-{{ section.id }} .lab-tab-content__title {
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .lab-tab-content__subtitle {
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .lab-result-property__icon {
      width: 50px;
      height: 50px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .lab-richtext__title {
      margin-bottom: 25px;
    }

    #shopify-section-{{ section.id }} .lab-richtext__content {
      font-size: 0.875rem;
    }

    #shopify-section-{{ section.id }} .lab-richtext__disclaimer {
      font-size: 0.75rem;
    }

    #shopify-section-{{ section.id }} .lab-tab-content__blocks {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }

    /* Mobile: full-width image on top, then properties in a 2x2 grid. */
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 14px;
      row-gap: 20px;
    }

    /* Clear every desktop placement (they out-specify a bare class reset), so
       the image sits on its own top row and the four properties flow into a
       plain 2x2 grid, each cell equal width. */
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property,
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(2),
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(3),
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(4),
    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property:nth-child(5) {
      grid-column: auto;
      grid-row: auto;
      justify-self: stretch;
    }

    #shopify-section-{{ section.id }} .lab-tab-content__blocks--with-media .lab-result-property__body {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .lab-tab-content__media {
      grid-column: 1 / -1;
      grid-row: 1 / 2;
      width: 100%;
      margin-inline: 0;
      align-self: auto;
      justify-self: stretch;
    }

    /* Cap tall product shots so the page isn't one long image on phones */
    #shopify-section-{{ section.id }} .lab-tab-content__image {
      margin-inline: auto;
      max-height: 340px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .lab-details {
      padding: 24px 20px;
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .lab-details__title {
      font-size: 1.25rem;
    }

    #shopify-section-{{ section.id }} .lab-details__logo-image {
      height: var(--lab-logo-h-m, 23px);
    }

    #shopify-section-{{ section.id }} .lab-details__properties {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }

    #shopify-section-{{ section.id }} .lab-property {
      grid-template-columns: 90px 1fr;
      font-size: 0.875rem;
    }

    #shopify-section-{{ section.id }} .lab-details__summary-label,
    #shopify-section-{{ section.id }} .lab-details__summary {
      font-size: 0.875rem;
    }

    #shopify-section-{{ section.id }} .lab-details__footer {
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .lab-details__report-link {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .lab-details__note {
      margin-top: 20px;
      font-size: 0.625rem;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .lab-tabs {
      padding-top: var(--lab-tabs-pt-m);
      padding-bottom: var(--lab-tabs-pb-m);
    }

    #shopify-section-{{ section.id }} .lab-tabs__nav {
      gap: 24px;
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .lab-tabs__tab {
      font-size: 1rem;
    }

    #shopify-section-{{ section.id }} .lab-tabs__tab[aria-selected='true'] {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }}');
    if (!root) return;

    var nav = root.querySelector('.lab-tabs__nav');
    var panels = Array.prototype.slice.call(root.querySelectorAll('.lab-tabs__panels > .lab-tab'));
    if (!nav || !panels.length) return;

    panels.forEach(function (panel) {
      var cards = Array.prototype.slice.call(panel.children).filter(function (el) {
        return el.classList.contains('lab-card');
      });
      if (cards.length < 2) return;
      var row = document.createElement('div');
      row.className = 'lab-tabs__cards';
      panel.insertBefore(row, cards[0]);
      cards.forEach(function (card) {
        row.appendChild(card);
      });
    });

    var uid = '{{ section.id }}';
    var tabs = panels.map(function (panel, i) {
      var tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'lab-tabs__tab';
      tab.setAttribute('role', 'tab');
      tab.id = 'tab-' + uid + '-' + i;
      tab.textContent = panel.dataset.labTabTitle || 'Tab';

      panel.id = 'panel-' + uid + '-' + i;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      tab.setAttribute('aria-controls', panel.id);

      nav.appendChild(tab);
      return tab;
    });

    function activate(index) {
      tabs.forEach(function (tab, i) {
        var selected = i === index;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.setAttribute('tabindex', selected ? '0' : '-1');
      });
      panels.forEach(function (panel, i) {
        panel.classList.toggle('is-active', i === index);
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        activate(i);
      });
      tab.addEventListener('keydown', function (event) {
        var next = null;
        if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
        if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        if (next === null) return;
        event.preventDefault();
        activate(next);
        tabs[next].focus();
      });
    });

    activate(0);
  })();
</script>

{% schema %}
{
  "name": "Lab Results Tabs",
  "tag": "section",
  "blocks": [
    { "type": "lab-tab" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "lab-results",
      "info": "Link here with /pages/lab-results#lab-results"
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Lab Results Tabs"
    }
  ]
}
{% endschema %}
