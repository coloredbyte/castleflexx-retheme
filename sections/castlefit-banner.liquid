{% comment %}
  CastleFit landing banner
  Desktop: full-bleed image (never cropped), copy overlaid on the left
  Mobile: copy on top, full image below (never cropped)
{% endcomment %}

{% render 'castlefit-landing-assets' %}

{%- liquid
  assign highlight_count = 0
  for block in section.blocks
    if block.type == 'highlight'
      assign highlight_count = highlight_count | plus: 1
    endif
  endfor

  assign banner_alt = section.settings.eyebrow | default: section.settings.title | escape

  assign use_section_anchors = false
  if template.name == 'product' or template.name == 'page'
    if template.suffix == 'castle-fit' or template.suffix == 'castlefit'
      assign use_section_anchors = true
    endif
  endif

  assign primary_href = '#castlefit-access'
  assign secondary_href = '#castlefit-pain'
  unless use_section_anchors
    if section.settings.cta_primary_url != blank
      assign primary_href = section.settings.cta_primary_url
    endif
    if section.settings.cta_secondary_url != blank
      assign secondary_href = section.settings.cta_secondary_url
    endif
  endunless
-%}

<section
  class="cf-banner"
  style="
    --cf-banner-bg: {{ section.settings.background_color }};
    --cf-banner-bg-mobile: {{ section.settings.mobile_background_color }};
  "
>
  <div class="cf-banner__media cf-banner__media--desktop">
    {%- if section.settings.image != blank -%}
      {% render 'castlefit-image',
        image: section.settings.image,
        class: 'cf-banner__img',
        max_width: 2880,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: banner_alt
      %}
    {%- endif -%}
  </div>

  <div class="cf-banner__inner">
    <div class="cf-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cf-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="cf-banner__title">{{ section.settings.title | newline_to_br }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="cf-banner__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if highlight_count > 0 -%}
        <ul class="cf-banner__highlights">
          {%- for block in section.blocks -%}
            {%- if block.type == 'highlight' -%}
              {%- liquid
                assign icon_file = 'icon-star.svg'
                if block.settings.icon == 'person'
                  assign icon_file = 'icon-person.svg'
                elsif block.settings.icon == 'protection'
                  assign icon_file = 'icon-protection.svg'
                endif
              -%}
              <li class="cf-banner__highlight" {{ block.shopify_attributes }}>
                <img
                  class="cf-banner__icon"
                  src="{{ icon_file | asset_url }}"
                  width="38"
                  height="38"
                  alt=""
                >
                <span class="cf-banner__highlight-text">
                  {%- if block.settings.heading != blank -%}
                    <strong>{{ block.settings.heading | escape }}</strong>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span>{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="cf-banner__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a class="cf-banner__btn" href="{{ primary_href }}">
              {{ section.settings.cta_primary_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.cta_secondary_label != blank -%}
            <a class="cf-banner__link" href="{{ secondary_href }}">
              {{ section.settings.cta_secondary_label | escape }}
              <svg viewBox="0 0 18 18" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M12.75 6 15.75 9m0 0-3 3m3-3H2.25" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="cf-banner__media cf-banner__media--mobile">
    {%- if section.settings.image_mobile != blank -%}
      {% render 'castlefit-image',
        image: section.settings.image_mobile,
        class: 'cf-banner__img',
        max_width: 1500,
        sizes: '100vw',
        loading: 'eager',
        alt: banner_alt
      %}
    {%- elsif section.settings.image != blank -%}
      {% render 'castlefit-image',
        image: section.settings.image,
        class: 'cf-banner__img',
        max_width: 1500,
        sizes: '100vw',
        loading: 'eager',
        alt: banner_alt
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CastleFit banner",
  "tag": "section",
  "class": "section-castlefit-banner",
  "enabled_on": {
    "templates": ["page", "product"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Desktop fallback color",
      "default": "#E36A3A"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile content background",
      "default": "#F7F8F6"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CastleFit Online Membership"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Unlimited\nClass Access"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Unlimited access to guided mobility, flexibility, and strength classes - choose based on pain area, age, or flexibility level."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Start Membership"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary link label",
      "default": "Explore by Pain Area"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary link URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Shown in full, never cropped. Use at least 2880px wide for a sharp desktop banner."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown in full below the copy, never cropped. Use at least 1500px wide for retina phones."
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "star", "label": "Star" },
            { "value": "person", "label": "Person" },
            { "value": "protection", "label": "Protection" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CastleFit banner",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "icon": "star",
            "heading": "200+",
            "text": "Guided Classes"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "person",
            "heading": "Age 65+",
            "text": "Flows by pain area"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "protection",
            "heading": "60-day",
            "text": "Full Refund"
          }
        }
      ]
    }
  ]
}
{% endschema %}
